<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Primary Notch Dark Palette -->
    <Color x:Key="NotchBackgroundDarkColor">#000000</Color>
    <SolidColorBrush x:Key="NotchBackgroundDarkBrush" Color="{StaticResource NotchBackgroundDarkColor}" />

    <Color x:Key="NotchPanelBackgroundDarkColor">#0D0D10</Color>
    <SolidColorBrush x:Key="NotchPanelBackgroundDarkBrush" Color="{StaticResource NotchPanelBackgroundDarkColor}" />

    <!-- Card Backgrounds: Premium Matte Charcoal with High Contrast -->
    <Color x:Key="NotchCardBackgroundDarkColor">#141418</Color>
    <SolidColorBrush x:Key="NotchCardBackgroundDarkBrush" Color="{StaticResource NotchCardBackgroundDarkColor}" />

    <Color x:Key="NotchCardHoverDarkColor">#1B1B22</Color>
    <SolidColorBrush x:Key="NotchCardHoverDarkBrush" Color="{StaticResource NotchCardHoverDarkColor}" />

    <!-- Border & Separator Brushes -->
    <Color x:Key="NotchBorderDarkColor">#2A2A34</Color>
    <SolidColorBrush x:Key="NotchBorderDarkBrush" Color="{StaticResource NotchBorderDarkColor}" />

    <Color x:Key="NotchSubtleBorderDarkColor">#1E1E26</Color>
    <SolidColorBrush x:Key="NotchSubtleBorderDarkBrush" Color="{StaticResource NotchSubtleBorderDarkColor}" />

    <!-- Refined Accents -->
    <Color x:Key="EmeraldColor">#10B981</Color>
    <SolidColorBrush x:Key="EmeraldBrush" Color="{StaticResource EmeraldColor}" />

    <Color x:Key="CalendarBlueColor">#3B82F6</Color>
    <SolidColorBrush x:Key="CalendarBlueBrush" Color="{StaticResource CalendarBlueColor}" />

    <Color x:Key="PinActiveColor">#F59E0B</Color>
    <SolidColorBrush x:Key="PinActiveBrush" Color="{StaticResource PinActiveColor}" />

    <!-- Mute / Alert Accent -->
    <Color x:Key="MuteRedColor">#EF4444</Color>
    <SolidColorBrush x:Key="MuteRedBrush" Color="{StaticResource MuteRedColor}" />
    <SolidColorBrush x:Key="MuteRedDarkBrush" Color="#3B1212" />

    <!-- Progress Track -->
    <SolidColorBrush x:Key="ProgressTrackBrush" Color="#2A2A34" />
    <SolidColorBrush x:Key="ProgressFillBrush" Color="#E4E4E7" />

    <!-- Typography Hierarchy (SF Pro / Segoe UI Variable inspired) -->
    <Color x:Key="TextPrimaryColor">#F4F4F5</Color>
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />

    <Color x:Key="TextSecondaryColor">#A1A1AA</Color>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />

    <Color x:Key="TextMutedColor">#71717A</Color>
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}" />

    <Color x:Key="TextDimColor">#52525B</Color>
    <SolidColorBrush x:Key="TextDimBrush" Color="{StaticResource TextDimColor}" />

    <!-- Interactive hover states -->
    <SolidColorBrush x:Key="ControlHoverBrush" Color="#2A2A34" />
    <SolidColorBrush x:Key="ControlPressedBrush" Color="#373746" />

</ResourceDictionary>
