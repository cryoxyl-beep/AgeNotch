<Window x:Class="GrumphySwarm.Views.NotchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewModels="clr-namespace:GrumphySwarm.ViewModels"
        xmlns:converters="clr-namespace:GrumphySwarm.Converters"
        xmlns:models="clr-namespace:GrumphySwarm.Core.Models;assembly=GrumphySwarm.Core"
        mc:Ignorable="d"
        Title="Grumphy Swarm Notch"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        ResizeMode="NoResize"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        d:DataContext="{d:DesignInstance viewModels:NotchViewModel}">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Resources/Colors.xaml" />
                <ResourceDictionary Source="/Resources/Icons.xaml" />
                <ResourceDictionary Source="/Resources/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <converters:BoolToVisibilityConverter x:Key="BoolToVisibility" />
            <converters:BoolToVisibilityConverter x:Key="InverseBoolToVisibility" Invert="True" />
            <converters:EqualityToVisibilityConverter x:Key="EqualityToVisibility" />
            <converters:EqualityToVisibilityConverter x:Key="InverseEqualityToVisibility" Invert="True" />
            <converters:TabActiveTagConverter x:Key="TabActiveTag" />
            <converters:ProgressToWidthConverter x:Key="ProgressToWidth" />
            <converters:NullToVisibilityConverter x:Key="NullToVisibility" />
            <converters:NullToVisibilityConverter x:Key="InverseNullToVisibility" Invert="True" />
        </ResourceDictionary>
    </Window.Resources>

    <!-- Transparent Window Root Grid -->
    <Grid Background="{x:Null}"
          HorizontalAlignment="Stretch"
          VerticalAlignment="Stretch">

        <!-- Visual Flared Notch Host Container -->
        <Grid x:Name="NotchContainer"
              HorizontalAlignment="Center"
              VerticalAlignment="Top"
              Width="230"
              Height="34"
              RenderOptions.BitmapScalingMode="HighQuality"
              MouseEnter="OnNotchMouseEnter"
              MouseLeave="OnNotchMouseLeave">

            <!-- Deep Pure Black Background Path (rendered with mathematical flared silhouette) -->
            <Path x:Name="NotchBackgroundPath"
                  Fill="#000000"
                  HorizontalAlignment="Stretch"
                  VerticalAlignment="Stretch"
                  IsHitTestVisible="True" />

            <!-- Clipped Content Host: guarantees content never bleeds outside flared silhouette -->
            <Grid x:Name="NotchClippedContent"
                  HorizontalAlignment="Stretch"
                  VerticalAlignment="Stretch">

                <!-- [1] COLLAPSED PILL VIEW (Matches Dynamic Island visual language) -->
                <Grid x:Name="CollapsedContentPanel"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch"
                      Opacity="1"
                      IsHitTestVisible="True">

                    <!-- [1A] NORMAL IDLE STATE (Permanent green dot removed; center clean) -->
                    <Grid Visibility="{Binding IsTemporaryStatusActive, Converter={StaticResource InverseBoolToVisibility}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Left: Real System Volume / Mute Speaker Icon -->
                        <StackPanel Grid.Column="0"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center"
                                    Margin="18,0,0,0">
                            <!-- Normal Volume Icon -->
                            <Path Data="{StaticResource IconVolumeGeometry}"
                                  Fill="{StaticResource TextPrimaryBrush}"
                                  Width="13"
                                  Height="13"
                                  Stretch="Uniform"
                                  VerticalAlignment="Center"
                                  Visibility="{Binding IsMuted, Converter={StaticResource InverseBoolToVisibility}}" />

                            <!-- Muted Speaker Icon -->
                            <Path Data="{StaticResource IconVolumeMuteGeometry}"
                                  Fill="{StaticResource MuteRedBrush}"
                                  Width="13"
                                  Height="13"
                                  Stretch="Uniform"
                                  VerticalAlignment="Center"
                                  Visibility="{Binding IsMuted, Converter={StaticResource BoolToVisibility}}" />
                        </StackPanel>

                        <!-- Center: Clean Empty Slot (No permanent glowing green dot) -->
                        <Grid Grid.Column="1" />

                        <!-- Right: Live System Volume Percentage or Muted Label -->
                        <StackPanel Grid.Column="2"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center"
                                    Margin="0,0,18,0">
                            <TextBlock Text="{Binding VolumeText}"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       FontFamily="Segoe UI Variable Display, Segoe UI, sans-serif"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Grid>

                    <!-- [1B] TEMPORARY DYNAMIC HUD PILL (Appears on Volume or Brightness change) -->
                    <!-- Matches the user's reference Dynamic Island status capsule style -->
                    <Grid Visibility="{Binding IsTemporaryStatusActive, Converter={StaticResource BoolToVisibility}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Left Slot: Status Icon with optional Mute pill capsule -->
                        <StackPanel Grid.Column="0"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center"
                                    Margin="16,0,0,0">
                            <!-- Normal Active Icon -->
                            <Path x:Name="HudNormalIcon"
                                  Fill="{StaticResource TextPrimaryBrush}"
                                  Width="12"
                                  Height="12"
                                  Stretch="Uniform"
                                  VerticalAlignment="Center"
                                  Visibility="{Binding IsTemporaryStatusMuted, Converter={StaticResource InverseBoolToVisibility}}">
                                <Path.Style>
                                    <Style TargetType="Path">
                                        <Setter Property="Data" Value="{StaticResource IconVolumeGeometry}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding TemporaryStatusIconKey}" Value="IconBrightnessGeometry">
                                                <Setter Property="Data" Value="{StaticResource IconBrightnessGeometry}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Path.Style>
                            </Path>

                            <!-- Muted / Silent Red Pill Capsule (Matches Reference Image) -->
                            <Border Background="{StaticResource MuteRedBrush}"
                                    CornerRadius="6"
                                    Padding="5,2"
                                    VerticalAlignment="Center"
                                    Visibility="{Binding IsTemporaryStatusMuted, Converter={StaticResource BoolToVisibility}}">
                                <Path Data="{StaticResource IconVolumeMuteGeometry}"
                                      Fill="White"
                                      Width="10"
                                      Height="10"
                                      Stretch="Uniform" />
                            </Border>
                        </StackPanel>

                        <!-- Center Slot: Contextual Title & Mini Progress Bar -->
                        <Grid Grid.Column="1" VerticalAlignment="Center" Margin="10,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0"
                                       Text="{Binding TemporaryStatusTitle}"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       FontSize="9"
                                       FontWeight="Medium"
                                       HorizontalAlignment="Center"
                                       Margin="0,0,0,2" />

                            <!-- Progress Track -->
                            <Border Grid.Row="1"
                                    Width="64"
                                    Height="3"
                                    Background="{StaticResource ProgressTrackBrush}"
                                    CornerRadius="1.5"
                                    HorizontalAlignment="Center">
                                <Border HorizontalAlignment="Left"
                                        Height="3"
                                        CornerRadius="1.5"
                                        Background="{StaticResource ProgressFillBrush}">
                                    <Border.Width>
                                        <MultiBinding Converter="{StaticResource ProgressToWidth}">
                                            <Binding Path="TemporaryStatusProgress" />
                                            <Binding Source="64.0" />
                                        </MultiBinding>
                                    </Border.Width>
                                </Border>
                            </Border>
                        </Grid>

                        <!-- Right Slot: Value (e.g. 68% or Muted) -->
                        <StackPanel Grid.Column="2"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center"
                                    Margin="0,0,16,0">
                            <TextBlock Text="{Binding TemporaryStatusValue}"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       FontFamily="Segoe UI Variable Display, Segoe UI, sans-serif"
                                       VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsTemporaryStatusMuted}" Value="True">
                                                <Setter Property="Foreground" Value="{StaticResource MuteRedBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Grid>
                </Grid>

                <!-- [2] EXPANDED NOTCH PANEL -->
                <Grid x:Name="ExpandedContentPanel"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch"
                      Opacity="0"
                      Visibility="Collapsed"
                      IsHitTestVisible="False">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="36" />
                        <!-- Header Row -->
                        <RowDefinition Height="*" />
                        <!-- Main Content Row -->
                        <RowDefinition Height="18" />
                        <!-- Bottom Pagination Row -->
                    </Grid.RowDefinitions>

                    <!-- Top Header: Tabs (Nook / Agents), Controls (Pin, Settings, Collapse) -->
                    <Grid Grid.Row="0" Margin="14,4,14,0" VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Left: Nook & Agents Pill Tab Buttons -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- Nook Tab -->
                            <Button Style="{StaticResource NotchTabButtonStyle}"
                                    Tag="{Binding ActiveTab, Converter={StaticResource TabActiveTag}, ConverterParameter='Nook'}"
                                    Command="{Binding SelectTabCommand}"
                                    CommandParameter="Nook"
                                    Margin="0,0,6,0">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconNookGeometry}"
                                          Fill="{StaticResource TextPrimaryBrush}"
                                          Width="10"
                                          Height="10"
                                          Stretch="Uniform"
                                          Margin="0,0,5,0"
                                          VerticalAlignment="Center" />
                                    <TextBlock Text="Nook" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <!-- Agents Tab (Renamed from Tray) -->
                            <Button Style="{StaticResource NotchTabButtonStyle}"
                                    Tag="{Binding ActiveTab, Converter={StaticResource TabActiveTag}, ConverterParameter='Agents'}"
                                    Command="{Binding SelectTabCommand}"
                                    CommandParameter="Agents">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconAgentsGeometry}"
                                          Fill="{StaticResource TextSecondaryBrush}"
                                          Width="11"
                                          Height="11"
                                          Stretch="Uniform"
                                          Margin="0,0,5,0"
                                          VerticalAlignment="Center" />
                                    <TextBlock Text="Agents" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <!-- Center: Clean / Contextual Status (Permanent Green Dot Removed) -->
                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Visibility="{Binding IsTemporaryStatusActive, Converter={StaticResource BoolToVisibility}}">
                            <Border Background="#1C1C24"
                                    BorderBrush="{StaticResource NotchSubtleBorderDarkBrush}"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="8,2">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding TemporaryStatusTitle}"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               FontSize="10"
                                               Margin="0,0,4,0" />
                                    <TextBlock Text="{Binding TemporaryStatusValue}"
                                               Foreground="{StaticResource TextPrimaryBrush}"
                                               FontSize="10"
                                               FontWeight="SemiBold" />
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Right: Actions (Pin, Settings, Collapse) -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- Pin Button -->
                            <Button Style="{StaticResource NotchIconButtonStyle}"
                                    Command="{Binding TogglePinCommand}"
                                    ToolTip="Pin notch open"
                                    Margin="0,0,4,0">
                                <Path Data="{StaticResource IconPinGeometry}"
                                      Width="12"
                                      Height="12"
                                      Stretch="Uniform">
                                    <Path.Style>
                                        <Style TargetType="Path">
                                            <Setter Property="Fill" Value="{StaticResource TextSecondaryBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsPinned}" Value="True">
                                                    <Setter Property="Fill" Value="{StaticResource PinActiveBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Path.Style>
                                </Path>
                            </Button>

                            <!-- Settings Button -->
                            <Button Style="{StaticResource NotchIconButtonStyle}"
                                    ToolTip="Settings"
                                    Margin="0,0,4,0">
                                <Path Data="{StaticResource IconGearGeometry}"
                                      Fill="{StaticResource TextSecondaryBrush}"
                                      Width="13"
                                      Height="13"
                                      Stretch="Uniform" />
                            </Button>

                            <!-- Collapse Button -->
                            <Button Style="{StaticResource NotchIconButtonStyle}"
                                    Command="{Binding ForceCollapseCommand}"
                                    ToolTip="Collapse">
                                <Path Data="{StaticResource IconChevronDownGeometry}"
                                      Fill="{StaticResource TextSecondaryBrush}"
                                      Width="12"
                                      Height="12"
                                      Stretch="Uniform">
                                    <Path.RenderTransform>
                                        <RotateTransform Angle="180" CenterX="6" CenterY="6" />
                                    </Path.RenderTransform>
                                </Path>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- Main Body Area -->
                    <Grid Grid.Row="1">

                        <!-- [2A] NOOK TAB CONTENT (Glanceable Dashboard) -->
                        <Grid Visibility="{Binding ActiveTab, Converter={StaticResource EqualityToVisibility}, ConverterParameter='Nook'}"
                              Margin="16,6,16,4">
                            <Grid.ColumnDefinitions>
                                <!-- Column 1: Live Media Player Widget -->
                                <ColumnDefinition Width="2.2*" />
                                <ColumnDefinition Width="12" />
                                <!-- Column 2: Date & Tasks Widget -->
                                <ColumnDefinition Width="2.2*" />
                                <ColumnDefinition Width="12" />
                                <!-- Column 3: Profile / Pet Widget -->
                                <ColumnDefinition Width="1.1*" />
                            </Grid.ColumnDefinitions>

                            <!-- Column 1: Real System Media Card (Windows GSMTC) -->
                            <Border Grid.Column="0"
                                    Background="{StaticResource NotchCardBackgroundDarkBrush}"
                                    BorderBrush="{StaticResource NotchSubtleBorderDarkBrush}"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    Padding="10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Album Art Thumbnail with Fallback -->
                                    <Border Grid.Column="0"
                                            Width="56"
                                            Height="56"
                                            CornerRadius="8"
                                            ClipToBounds="True"
                                            Background="#181820"
                                            Margin="0,0,10,0">
                                        <Grid>
                                            <!-- Live Album Art -->
                                            <Image Source="{Binding MediaThumbnailSource}"
                                                   Stretch="UniformToFill"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />

                                            <!-- Fallback Music Note Icon when no thumbnail -->
                                            <Border Background="#1C1C24"
                                                    Visibility="{Binding MediaThumbnailSource, Converter={StaticResource InverseNullToVisibility}, FallbackValue=Visible}">
                                                <Path Data="{StaticResource IconMusicNoteGeometry}"
                                                      Fill="{StaticResource TextMutedBrush}"
                                                      Width="18"
                                                      Height="18"
                                                      Stretch="Uniform"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center" />
                                            </Border>
                                        </Grid>
                                    </Border>

                                    <!-- Track Info & Controls -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding MusicTrackTitle}"
                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   FontFamily="Segoe UI Variable Display, Segoe UI, sans-serif"
                                                   TextTrimming="CharacterEllipsis" />

                                        <TextBlock Text="{Binding MusicArtist}"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   FontSize="10"
                                                   Margin="0,1,0,0"
                                                   TextTrimming="CharacterEllipsis" />

                                        <TextBlock Text="{Binding MusicAlbum}"
                                                   Foreground="{StaticResource TextMutedBrush}"
                                                   FontSize="9"
                                                   TextTrimming="CharacterEllipsis" />

                                        <!-- Real Transport Controls -->
                                        <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                            <!-- Previous Button -->
                                            <Button Style="{StaticResource NotchIconButtonStyle}"
                                                    Command="{Binding MediaSkipPreviousCommand}"
                                                    IsEnabled="{Binding CanSkipPrevious}"
                                                    Padding="3"
                                                    Margin="0,0,4,0"
                                                    ToolTip="Previous track">
                                                <Path Data="{StaticResource IconPrevGeometry}"
                                                      Fill="{StaticResource TextSecondaryBrush}"
                                                      Width="10"
                                                      Height="10"
                                                      Stretch="Uniform" />
                                            </Button>

                                            <!-- Play / Pause Button -->
                                            <Button Style="{StaticResource NotchIconButtonStyle}"
                                                    Command="{Binding ToggleMediaPlayPauseCommand}"
                                                    IsEnabled="{Binding CanPlayPause}"
                                                    Padding="3"
                                                    Margin="0,0,4,0"
                                                    ToolTip="Play / Pause">
                                                <Path Width="10"
                                                      Height="10"
                                                      Stretch="Uniform"
                                                      Fill="{StaticResource TextPrimaryBrush}">
                                                    <Path.Style>
                                                        <Style TargetType="Path">
                                                            <Setter Property="Data" Value="{StaticResource IconPlayGeometry}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding MediaIsPlaying}" Value="True">
                                                                    <Setter Property="Data" Value="{StaticResource IconPauseGeometry}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Path.Style>
                                                </Path>
                                            </Button>

                                            <!-- Next Button -->
                                            <Button Style="{StaticResource NotchIconButtonStyle}"
                                                    Command="{Binding MediaSkipNextCommand}"
                                                    IsEnabled="{Binding CanSkipNext}"
                                                    Padding="3"
                                                    ToolTip="Next track">
                                                <Path Data="{StaticResource IconNextGeometry}"
                                                      Fill="{StaticResource TextSecondaryBrush}"
                                                      Width="10"
                                                      Height="10"
                                                      Stretch="Uniform" />
                                            </Button>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Column 2: Calendar / Date / Schedule -->
                            <Border Grid.Column="2"
                                    Background="{StaticResource NotchCardBackgroundDarkBrush}"
                                    BorderBrush="{StaticResource NotchSubtleBorderDarkBrush}"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    Padding="10,8">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <!-- Month and Days Row -->
                                    <Grid Grid.Row="0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Live Month Label -->
                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding CurrentDateMonthText, FallbackValue='Oct'}"
                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                   FontSize="14"
                                                   FontWeight="Bold"
                                                   FontFamily="Segoe UI Variable Display, Segoe UI, sans-serif"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,10,0" />

                                        <!-- Calendar Days Strip with Active Highlight -->
                                        <UniformGrid Grid.Column="1" Columns="5" HorizontalAlignment="Stretch">
                                            <StackPanel HorizontalAlignment="Center">
                                                <TextBlock Text="M" FontSize="8" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center" />
                                                <TextBlock Text="19" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,2,0,0" />
                                            </StackPanel>
                                            <StackPanel HorizontalAlignment="Center">
                                                <TextBlock Text="T" FontSize="8" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center" />
                                                <TextBlock Text="20" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,2,0,0" />
                                            </StackPanel>
                                            <!-- Today (Live Active Highlight) -->
                                            <Border Background="{StaticResource CalendarBlueBrush}"
                                                    CornerRadius="6"
                                                    Padding="4,2"
                                                    HorizontalAlignment="Center">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding CurrentDateWeekdayText, FallbackValue='WED'}"
                                                               FontSize="8"
                                                               FontWeight="Bold"
                                                               Foreground="White"
                                                               HorizontalAlignment="Center" />
                                                    <TextBlock Text="{Binding CurrentDateDayText, FallbackValue='21'}"
                                                               FontSize="11"
                                                               FontWeight="Bold"
                                                               Foreground="White"
                                                               HorizontalAlignment="Center" />
                                                </StackPanel>
                                            </Border>
                                            <StackPanel HorizontalAlignment="Center">
                                                <TextBlock Text="T" FontSize="8" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center" />
                                                <TextBlock Text="22" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,2,0,0" />
                                            </StackPanel>
                                            <StackPanel HorizontalAlignment="Center">
                                                <TextBlock Text="F" FontSize="8" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center" />
                                                <TextBlock Text="23" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,2,0,0" />
                                            </StackPanel>
                                        </UniformGrid>
                                    </Grid>

                                    <!-- Calendar Event Subtitle -->
                                    <StackPanel Grid.Row="1"
                                                Orientation="Horizontal"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Margin="0,8,0,0">
                                        <Path Data="{StaticResource IconCalendarGeometry}"
                                              Fill="{StaticResource TextMutedBrush}"
                                              Width="10"
                                              Height="10"
                                              Stretch="Uniform"
                                              Margin="0,0,5,0"
                                              VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding CalendarEventTitle, FallbackValue='Nothing for today'}"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   FontSize="10"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Column 3: Avatar / Desktop Pet Reserved -->
                            <Border Grid.Column="4"
                                    Background="{StaticResource NotchCardBackgroundDarkBrush}"
                                    BorderBrush="{StaticResource NotchSubtleBorderDarkBrush}"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    Padding="8"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Stretch">
                                <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Ellipse Width="56"
                                             Height="56"
                                             Stroke="{StaticResource NotchBorderDarkBrush}"
                                             StrokeThickness="1.5" />
                                    <Ellipse Width="50" Height="50">
                                        <Ellipse.Fill>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                <GradientStop Color="#334155" Offset="0" />
                                                <GradientStop Color="#0F172A" Offset="1" />
                                            </LinearGradientBrush>
                                        </Ellipse.Fill>
                                    </Ellipse>
                                    <Path Data="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"
                                          Fill="{StaticResource TextSecondaryBrush}"
                                          Width="22"
                                          Height="22"
                                          Stretch="Uniform"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                        </Grid>

                        <!-- [2B] AGENTS WORKSPACE VIEW (ActiveTab == 'Agents') -->
                        <Grid Visibility="{Binding ActiveTab, Converter={StaticResource EqualityToVisibility}, ConverterParameter='Agents'}"
                              Margin="16,4,16,4">

                            <!-- VIEW 1: Profiles List View -->
                            <Grid Visibility="{Binding IsEditingAgent, Converter={StaticResource InverseBoolToVisibility}}">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <!-- Header Bar: Title, Count, and Create Button -->
                                <Grid Grid.Row="0" Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="Agent Swarm"
                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   FontFamily="Segoe UI Variable Display, Segoe UI, sans-serif"
                                                   VerticalAlignment="Center" />
                                        <Border Background="#1C1C24"
                                                CornerRadius="8"
                                                Padding="6,1"
                                                Margin="8,0,0,0"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="{Binding AgentProfiles.Count, StringFormat='{}{0} configured'}"
                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                       FontSize="9" />
                                        </Border>
                                    </StackPanel>

                                    <!-- "+ Create Agent" Button -->
                                    <Button Grid.Column="1"
                                            Style="{StaticResource NotchAccentButtonStyle}"
                                            Command="{Binding OpenCreateAgentCommand}">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="{StaticResource IconPlusGeometry}"
                                                  Fill="White"
                                                  Width="9"
                                                  Height="9"
                                                  Stretch="Uniform"
                                                  Margin="0,0,4,0"
                                                  VerticalAlignment="Center" />
                                            <TextBlock Text="Create Agent" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </Grid>

                                <!-- Cards List -->
                                <ScrollViewer Grid.Row="1"
                                              VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled">
                                    <ItemsControl ItemsSource="{Binding AgentProfiles}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <UniformGrid Columns="2" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type viewModels:AgentItemViewModel}">
                                                <Border Background="{StaticResource NotchCardBackgroundDarkBrush}"
                                                        BorderBrush="{StaticResource NotchSubtleBorderDarkBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="10"
                                                        Padding="10,8"
                                                        Margin="4">
                                                    <Grid>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="*" />
                                                            <RowDefinition Height="Auto" />
                                                        </Grid.RowDefinitions>

                                                        <!-- Row 0: Name and Type Tag -->
                                                        <Grid Grid.Row="0">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>

                                                            <TextBlock Grid.Column="0"
                                                                       Text="{Binding Name}"
                                                                       Foreground="{StaticResource TextPrimaryBrush}"
                                                                       FontSize="11"
                                                                       FontWeight="SemiBold"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       VerticalAlignment="Center" />

                                                            <!-- Task Type Tag -->
                                                            <Border Grid.Column="1"
                                                                    Background="#1E1E28"
                                                                    CornerRadius="5"
                                                                    Padding="5,1"
                                                                    Margin="4,0,0,0">
                                                                <TextBlock Text="{Binding TaskTypeLabel}"
                                                                           Foreground="{StaticResource TextSecondaryBrush}"
                                                                           FontSize="8" />
                                                            </Border>
                                                        </Grid>

                                                        <!-- Row 1: Description -->
                                                        <TextBlock Grid.Row="1"
                                                                   Text="{Binding Description}"
                                                                   Foreground="{StaticResource TextMutedBrush}"
                                                                   FontSize="9"
                                                                   TextWrapping="Wrap"
                                                                   MaxHeight="26"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   Margin="0,3,0,6" />

                                                        <!-- Row 2: Status Note & Action Buttons -->
                                                        <Grid Grid.Row="2">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>

                                                            <!-- Standby Status Badge -->
                                                            <Border Grid.Column="0"
                                                                    Background="#181822"
                                                                    BorderBrush="{StaticResource NotchSubtleBorderDarkBrush}"
                                                                    BorderThickness="1"
                                                                    CornerRadius="4"
                                                                    Padding="4,1"
                                                                    HorizontalAlignment="Left"
                                                                    VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding StatusNote}"
                                                                           Foreground="#94A3B8"
                                                                           FontSize="8" />
                                                            </Border>

                                                            <!-- Action Buttons: Edit, Delete -->
                                                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                                <Button Style="{StaticResource NotchIconButtonStyle}"
                                                                        Command="{Binding EditCommand}"
                                                                        ToolTip="Edit Profile"
                                                                        Padding="2"
                                                                        Margin="0,0,2,0">
                                                                    <Path Data="{StaticResource IconEditGeometry}"
                                                                          Fill="{StaticResource TextMutedBrush}"
                                                                          Width="9"
                                                                          Height="9"
                                                                          Stretch="Uniform" />
                                                                </Button>
                                                                <Button Style="{StaticResource NotchIconButtonStyle}"
                                                                        Command="{Binding DeleteCommand}"
                                                                        ToolTip="Delete Profile"
                                                                        Padding="2">
                                                                    <Path Data="{StaticResource IconDeleteGeometry}"
                                                                          Fill="{StaticResource TextMutedBrush}"
                                                                          Width="9"
                                                                          Height="9"
                                                                          Stretch="Uniform" />
                                                                </Button>
                                                            </StackPanel>
                                                        </Grid>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Grid>

                            <!-- VIEW 2: Agent Profile Editor Modal/Card -->
                            <Border Visibility="{Binding IsEditingAgent, Converter={StaticResource BoolToVisibility}}"
                                    Background="{StaticResource NotchCardBackgroundDarkBrush}"
                                    BorderBrush="{StaticResource NotchBorderDarkBrush}"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    Padding="14,10">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <!-- Editor Header -->
                                    <TextBlock Grid.Row="0"
                                               Text="{Binding EditorTitle}"
                                               Foreground="{StaticResource TextPrimaryBrush}"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Margin="0,0,0,8" />

                                    <!-- Name Field -->
                                    <Grid Grid.Row="1" Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="60" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0"
                                                   Text="Name:"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   FontSize="10"
                                                   VerticalAlignment="Center" />
                                        <TextBox Grid.Column="1"
                                                 Style="{StaticResource NotchTextBoxStyle}"
                                                 Text="{Binding EditorAgentName, UpdateSourceTrigger=PropertyChanged}" />
                                    </Grid>

                                    <!-- Description Field -->
                                    <Grid Grid.Row="2" Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="60" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0"
                                                   Text="Task Goal:"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   FontSize="10"
                                                   VerticalAlignment="Center" />
                                        <TextBox Grid.Column="1"
                                                 Style="{StaticResource NotchTextBoxStyle}"
                                                 Text="{Binding EditorAgentDescription, UpdateSourceTrigger=PropertyChanged}" />
                                    </Grid>

                                    <!-- Action Buttons -->
                                    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button Style="{StaticResource NotchGhostButtonStyle}"
                                                Command="{Binding CancelAgentEditCommand}"
                                                Margin="0,0,6,0">
                                            <TextBlock Text="Cancel" />
                                        </Button>
                                        <Button Style="{StaticResource NotchAccentButtonStyle}"
                                                Command="{Binding SaveAgentProfileCommand}">
                                            <StackPanel Orientation="Horizontal">
                                                <Path Data="{StaticResource IconCheckGeometry}"
                                                      Fill="White"
                                                      Width="9"
                                                      Height="9"
                                                      Stretch="Uniform"
                                                      Margin="0,0,4,0"
                                                      VerticalAlignment="Center" />
                                                <TextBlock Text="Save Agent" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>

                    </Grid>

                    <!-- Bottom Carousel Pagination Indicator Dots -->
                    <StackPanel Grid.Row="2"
                                Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Margin="0,0,0,4">
                        <Ellipse Width="4" Height="4" Fill="{StaticResource TextMutedBrush}" Margin="2,0" />
                        <Border Width="12" Height="3" CornerRadius="1.5" Background="{StaticResource TextSecondaryBrush}" Margin="2,0" />
                        <Ellipse Width="4" Height="4" Fill="{StaticResource TextMutedBrush}" Margin="2,0" />
                        <Ellipse Width="4" Height="4" Fill="{StaticResource TextMutedBrush}" Margin="2,0" />
                        <Ellipse Width="4" Height="4" Fill="{StaticResource TextMutedBrush}" Margin="2,0" />
                    </StackPanel>
                </Grid>

            </Grid>
        </Grid>
    </Grid>
</Window>
