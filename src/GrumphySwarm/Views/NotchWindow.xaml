<Window x:Class="GrumphySwarm.Views.NotchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewModels="clr-namespace:GrumphySwarm.ViewModels"
        xmlns:converters="clr-namespace:GrumphySwarm.Converters"
        xmlns:models="clr-namespace:GrumphySwarm.Core.Models;assembly=GrumphySwarm.Core"
        mc:Ignorable="d"
        Title="AgeNotch"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        ResizeMode="NoResize"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        d:DataContext="{d:DesignInstance viewModels:NotchViewModel}">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/GrumphySwarm;component/Resources/Colors.xaml" />
                <ResourceDictionary Source="pack://application:,,,/GrumphySwarm;component/Resources/Icons.xaml" />
                <ResourceDictionary Source="pack://application:,,,/GrumphySwarm;component/Resources/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <converters:BoolToVisibilityConverter x:Key="BoolToVisibility" />
            <converters:BoolToVisibilityConverter x:Key="InverseBoolToVisibility" Invert="True" />
            <converters:EqualityToVisibilityConverter x:Key="EqualityToVisibility" />
            <converters:EqualityToVisibilityConverter x:Key="InverseEqualityToVisibility" Invert="True" />
            <converters:TabActiveTagConverter x:Key="TabActiveTag" />
            <converters:PositionToTagConverter x:Key="PositionToTag" />
            <converters:DoubleToPxConverter x:Key="DoubleToPx" />
            <converters:ProgressToWidthConverter x:Key="ProgressToWidth" />
            <converters:NullToVisibilityConverter x:Key="NullToVisibility" />
            <converters:NullToVisibilityConverter x:Key="InverseNullToVisibility" Invert="True" />
        </ResourceDictionary>
    </Window.Resources>

    <!-- Transparent Window Root Grid (Passes through clicks on alpha=0 to underlying apps) -->
    <Grid Background="{x:Null}"
          HorizontalAlignment="Stretch"
          VerticalAlignment="Stretch">

        <!-- Visual Flared Notch Host Container -->
        <Grid x:Name="NotchContainer"
              HorizontalAlignment="Center"
              VerticalAlignment="Top"
              Width="240"
              Height="34"
              RenderOptions.BitmapScalingMode="HighQuality"
              MouseEnter="OnNotchMouseEnter"
              MouseLeave="OnNotchMouseLeave">

            <!-- Deep Pure Black Background Path (mathematical flared silhouette) -->
            <Path x:Name="NotchBackgroundPath"
                  Fill="#000000"
                  HorizontalAlignment="Stretch"
                  VerticalAlignment="Stretch"
                  IsHitTestVisible="True" />

            <!-- Clipped Content Host: guarantees content never bleeds outside flared silhouette -->
            <Grid x:Name="NotchClippedContent"
                  HorizontalAlignment="Stretch"
                  VerticalAlignment="Stretch">

                <!-- ============================================================== -->
                <!-- [1] COLLAPSED PILL VIEW (Dynamic Island Pill)                  -->
                <!-- ============================================================== -->
                <Grid x:Name="CollapsedContentPanel"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch"
                      Opacity="1"
                      IsHitTestVisible="True">

                    <!-- [1A] NORMAL IDLE STATE (Volume on left, value on right) -->
                    <Grid Visibility="{Binding IsTemporaryStatusActive, Converter={StaticResource InverseBoolToVisibility}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Left: Real System Volume / Mute Speaker Icon -->
                        <StackPanel Grid.Column="0"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center"
                                    Margin="18,0,0,0">
                            <!-- Normal Volume Icon -->
                            <Path Data="{StaticResource IconVolumeGeometry}"
                                  Fill="{StaticResource TextPrimaryBrush}"
                                  Width="13"
                                  Height="13"
                                  Stretch="Uniform"
                                  VerticalAlignment="Center"
                                  Visibility="{Binding IsMuted, Converter={StaticResource InverseBoolToVisibility}}" />

                            <!-- Muted Speaker Icon -->
                            <Path Data="{StaticResource IconVolumeMuteGeometry}"
                                  Fill="{StaticResource MuteRedBrush}"
                                  Width="13"
                                  Height="13"
                                  Stretch="Uniform"
                                  VerticalAlignment="Center"
                                  Visibility="{Binding IsMuted, Converter={StaticResource BoolToVisibility}}" />
                        </StackPanel>

                        <!-- Center: Clean Empty Slot (Distraction-free) -->
                        <Grid Grid.Column="1" />

                        <!-- Right: Live System Volume Percentage or Muted Label -->
                        <StackPanel Grid.Column="2"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center"
                                    Margin="0,0,18,0">
                            <TextBlock Text="{Binding VolumeText}"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       FontFamily="Segoe UI Variable Display, Segoe UI, sans-serif"
                                       Typography.NumeralAlignment="Tabular"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Grid>

                    <!-- [1B] TEMPORARY DYNAMIC HUD PILL (Volume or Brightness change) -->
                    <Grid Visibility="{Binding IsTemporaryStatusActive, Converter={StaticResource BoolToVisibility}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Left Slot: Status Icon with optional Mute pill capsule -->
                        <StackPanel Grid.Column="0"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center"
                                    Margin="16,0,0,0">
                            <Path Fill="{StaticResource TextPrimaryBrush}"
                                  Width="12"
                                  Height="12"
                                  Stretch="Uniform"
                                  VerticalAlignment="Center"
                                  Visibility="{Binding IsTemporaryStatusMuted, Converter={StaticResource InverseBoolToVisibility}}">
                                <Path.Style>
                                    <Style TargetType="Path">
                                        <Setter Property="Data" Value="{StaticResource IconVolumeGeometry}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding TemporaryStatusIconKey}" Value="IconBrightnessGeometry">
                                                <Setter Property="Data" Value="{StaticResource IconBrightnessGeometry}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Path.Style>
                            </Path>

                            <!-- Muted / Silent Red Pill Capsule -->
                            <Border Background="{StaticResource MuteRedBrush}"
                                    CornerRadius="6"
                                    Padding="5,2"
                                    VerticalAlignment="Center"
                                    Visibility="{Binding IsTemporaryStatusMuted, Converter={StaticResource BoolToVisibility}}">
                                <Path Data="{StaticResource IconVolumeMuteGeometry}"
                                      Fill="White"
                                      Width="10"
                                      Height="10"
                                      Stretch="Uniform" />
                            </Border>
                        </StackPanel>

                        <!-- Center Slot: Contextual Title & Mini Progress Bar -->
                        <Grid Grid.Column="1" VerticalAlignment="Center" Margin="10,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0"
                                       Text="{Binding TemporaryStatusTitle}"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       FontSize="9"
                                       FontWeight="Medium"
                                       HorizontalAlignment="Center"
                                       Margin="0,0,0,2" />

                            <Border Grid.Row="1"
                                    Width="64"
                                    Height="3"
                                    Background="{StaticResource ProgressTrackBrush}"
                                    CornerRadius="1.5"
                                    HorizontalAlignment="Center">
                                <Border HorizontalAlignment="Left"
                                        Height="3"
                                        CornerRadius="1.5"
                                        Background="{StaticResource ProgressFillBrush}">
                                    <Border.Width>
                                        <MultiBinding Converter="{StaticResource ProgressToWidth}">
                                            <Binding Path="TemporaryStatusProgress" />
                                            <Binding Source="64.0" />
                                        </MultiBinding>
                                    </Border.Width>
                                </Border>
                            </Border>
                        </Grid>

                        <!-- Right Slot: Value (e.g. 68% or Muted) -->
                        <StackPanel Grid.Column="2"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center"
                                    Margin="0,0,16,0">
                            <TextBlock Text="{Binding TemporaryStatusValue}"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       FontFamily="Segoe UI Variable Display, Segoe UI, sans-serif"
                                       Typography.NumeralAlignment="Tabular"
                                       VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsTemporaryStatusMuted}" Value="True">
                                                <Setter Property="Foreground" Value="{StaticResource MuteRedBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Grid>
                </Grid>

                <!-- ============================================================== -->
                <!-- [2] EXPANDED NOTCH PANEL                                       -->
                <!-- ============================================================== -->
                <Grid x:Name="ExpandedContentPanel"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch"
                      Opacity="0"
                      Visibility="Collapsed"
                      IsHitTestVisible="False">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="28" />
                        <!-- Header Row -->
                        <RowDefinition Height="*" />
                        <!-- Main Content Row -->
                    </Grid.RowDefinitions>

                    <!-- TOP HEADER: Dynamic header adapting to ActiveView -->
                    <Grid Grid.Row="0" Margin="26,4,26,0" VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Left Slot: Tabs (when in Dashboard) OR Back button (when in Sub-view) -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- Dashboard Tabs (Visible in Dashboard view) -->
                            <StackPanel Orientation="Horizontal"
                                        Visibility="{Binding ActiveView, Converter={StaticResource EqualityToVisibility}, ConverterParameter='Dashboard'}">
                                <!-- Nook Tab -->
                                <Button Style="{StaticResource NotchTabButtonStyle}"
                                        Tag="{Binding ActiveTab, Converter={StaticResource TabActiveTag}, ConverterParameter='Nook'}"
                                        Command="{Binding SelectTabCommand}"
                                        CommandParameter="Nook"
                                        ToolTip="Dashboard view"
                                        Margin="0,0,4,0">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource IconDeskLampGeometry}"
                                              Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                                              Width="11"
                                              Height="11"
                                              Stretch="Uniform"
                                              Margin="0,0,5,0"
                                              VerticalAlignment="Center" />
                                        <TextBlock Text="Nook" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>

                                <!-- Tray Tab -->
                                <Button Style="{StaticResource NotchTabButtonStyle}"
                                        Tag="{Binding ActiveTab, Converter={StaticResource TabActiveTag}, ConverterParameter='Agents'}"
                                        Command="{Binding SelectTabCommand}"
                                        CommandParameter="Agents"
                                        ToolTip="Agent fleet management">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource IconTrayGeometry}"
                                              Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                                              Width="11"
                                              Height="11"
                                              Stretch="Uniform"
                                              Margin="0,0,5,0"
                                              VerticalAlignment="Center" />
                                        <TextBlock Text="Tray" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>

                            <!-- Back button (Visible in NowPlayingCenter or Settings) -->
                            <Button Style="{StaticResource NotchGhostButtonStyle}"
                                    Command="{Binding CloseNowPlayingCenterCommand}"
                                    ToolTip="Return to Nook Dashboard"
                                    Visibility="{Binding ActiveView, Converter={StaticResource EqualityToVisibility}, ConverterParameter='NowPlayingCenter'}">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconArrowBackGeometry}"
                                          Fill="{StaticResource TextSecondaryBrush}"
                                          Width="10"
                                          Height="10"
                                          Stretch="Uniform"
                                          Margin="0,0,5,0"
                                          VerticalAlignment="Center" />
                                    <TextBlock Text="Nook" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <Button Style="{StaticResource NotchGhostButtonStyle}"
                                    Command="{Binding CloseSettingsCommand}"
                                    ToolTip="Return to Dashboard"
                                    Visibility="{Binding ActiveView, Converter={StaticResource EqualityToVisibility}, ConverterParameter='Settings'}">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconArrowBackGeometry}"
                                          Fill="{StaticResource TextSecondaryBrush}"
                                          Width="10"
                                          Height="10"
                                          Stretch="Uniform"
                                          Margin="0,0,5,0"
                                          VerticalAlignment="Center" />
                                    <TextBlock Text="Back" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <!-- Center Slot: Contextual Title or Camera Lens Indicator -->
                        <Grid Grid.Column="1"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center">
                            <!-- Camera Lens with Dual Optical Reflection Aperture (Matching Reference) -->
                            <Grid HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  Visibility="{Binding ActiveView, Converter={StaticResource EqualityToVisibility}, ConverterParameter='Dashboard'}">
                                <Ellipse Width="8.5"
                                         Height="8.5"
                                         Fill="#0B0B10"
                                         Stroke="#181822"
                                         StrokeThickness="0.8" />
                                <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Ellipse Width="2.5" Height="2" Fill="#0A84FF" Opacity="0.9" Margin="0,0,0,1" />
                                    <Ellipse Width="2.5" Height="2" Fill="#00D2FF" Opacity="0.85" />
                                </StackPanel>
                            </Grid>

                            <!-- Now Playing Source App Title in Control Center -->
                            <TextBlock Text="{Binding MediaSourceAppName}"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       FontSize="11"
                                       FontWeight="Medium"
                                       Visibility="{Binding ActiveView, Converter={StaticResource EqualityToVisibility}, ConverterParameter='NowPlayingCenter'}" />

                            <!-- Settings Title in Settings View -->
                            <TextBlock Text="Notch Customization &amp; Position"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Visibility="{Binding ActiveView, Converter={StaticResource EqualityToVisibility}, ConverterParameter='Settings'}" />
                        </Grid>

                        <!-- Right Slot: Action Buttons (Settings Gear only in main header) -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- Settings Button -->
                            <Button Style="{StaticResource NotchIconButtonStyle}"
                                    Command="{Binding OpenSettingsCommand}"
                                    ToolTip="Notch Settings">
                                <Path Data="{StaticResource IconGearGeometry}"
                                      Fill="{StaticResource TextSecondaryBrush}"
                                      Width="13"
                                      Height="13"
                                      Stretch="Uniform" />
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- MAIN BODY: Multi-view container (Dashboard, NowPlayingCenter, Settings) -->
                    <Grid Grid.Row="1" Margin="26,2,26,8">

                        <!-- ============================================================== -->
                        <!-- [VIEW 1] DASHBOARD VIEW: NOOK & AGENTS                         -->
                        <!-- ============================================================== -->
                        <Grid Visibility="{Binding ActiveView, Converter={StaticResource EqualityToVisibility}, ConverterParameter='Dashboard'}">

                            <!-- [1A] NOOK TAB: Unified 1:1 Dynamic Island Composition (Direct on Pure Black) -->
                            <Grid Visibility="{Binding ActiveTab, Converter={StaticResource EqualityToVisibility}, ConverterParameter='Nook'}"
                                  UseLayoutRounding="True"
                                  SnapsToDevicePixels="True"
                                  VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <!-- Column 0: Left Media Section (Proportional ~39%) -->
                                    <ColumnDefinition Width="246" />
                                    <!-- Column 1: Faint Hairline Divider -->
                                    <ColumnDefinition Width="Auto" />
                                    <!-- Column 2: Center Calendar Section (Proportional ~44%) -->
                                    <ColumnDefinition Width="*" />
                                    <!-- Column 3: Faint Hairline Divider -->
                                    <ColumnDefinition Width="Auto" />
                                    <!-- Column 4: Right Avatar Section (Proportional ~17%) -->
                                    <ColumnDefinition Width="100" />
                                </Grid.ColumnDefinitions>

                                <!-- SECTION 1: Media Section (Direct on Black, Clickable to open Control Center) -->
                                <Grid Grid.Column="0"
                                      Cursor="Hand"
                                      Background="Transparent"
                                      ToolTip="Click to open Now Playing Control Center"
                                      VerticalAlignment="Center">
                                    <Grid.InputBindings>
                                        <MouseBinding MouseAction="LeftClick" Command="{Binding OpenNowPlayingCenterCommand}" />
                                    </Grid.InputBindings>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Album Artwork with Source App Badge -->
                                    <Grid Grid.Column="0" Margin="0,0,12,0" VerticalAlignment="Center">
                                        <Border Width="64"
                                                Height="64"
                                                CornerRadius="10"
                                                ClipToBounds="True"
                                                Background="#141418">
                                            <Grid>
                                                <!-- Default Album Art from Reference Spec -->
                                                <Image Source="pack://application:,,,/GrumphySwarm;component/Resources/album_default.png"
                                                       Stretch="UniformToFill"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" />

                                                <!-- Live GSMTC Artwork if playing -->
                                                <Image Source="{Binding MediaThumbnailSource}"
                                                       Stretch="UniformToFill"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       Visibility="{Binding MediaThumbnailSource, Converter={StaticResource NullToVisibility}}" />
                                            </Grid>
                                        </Border>

                                        <!-- Source App Badge Icon (Bottom Right of Artwork) -->
                                        <Border HorizontalAlignment="Right"
                                                VerticalAlignment="Bottom"
                                                Width="19"
                                                Height="19"
                                                CornerRadius="5"
                                                Margin="0,0,-2,-2"
                                                BorderBrush="#000000"
                                                BorderThickness="1.5"
                                                SnapsToDevicePixels="True">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#FA2D48" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding MediaSourceAppBadgeKey}" Value="IconSpotifyBadge">
                                                            <Setter Property="Background" Value="#1DB954" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding MediaSourceAppBadgeKey}" Value="IconBrowserBadge">
                                                            <Setter Property="Background" Value="#2563EB" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding MediaSourceAppBadgeKey}" Value="IconGenericMusicBadge">
                                                            <Setter Property="Background" Value="#6366F1" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <Path Width="10"
                                                  Height="10"
                                                  Stretch="Uniform"
                                                  Fill="White"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center">
                                                <Path.Style>
                                                    <Style TargetType="Path">
                                                        <Setter Property="Data" Value="{StaticResource IconAppleMusicBadge}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding MediaSourceAppBadgeKey}" Value="IconSpotifyBadge">
                                                                <Setter Property="Data" Value="{StaticResource IconSpotifyBadge}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding MediaSourceAppBadgeKey}" Value="IconBrowserBadge">
                                                                <Setter Property="Data" Value="{StaticResource IconBrowserBadge}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding MediaSourceAppBadgeKey}" Value="IconGenericMusicBadge">
                                                                <Setter Property="Data" Value="{StaticResource IconMusicNoteGeometry}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Path.Style>
                                            </Path>
                                        </Border>
                                    </Grid>

                                    <!-- Track Metadata & Mini Controls beside artwork -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <!-- Line 1: Track Title -->
                                        <TextBlock Text="{Binding MusicTrackTitle, FallbackValue='Dibi Dibi Rek'}"
                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                   FontSize="12.5"
                                                   FontWeight="SemiBold"
                                                   FontFamily="Segoe UI Variable Display, Segoe UI, sans-serif"
                                                   TextTrimming="CharacterEllipsis"
                                                   MaxHeight="17" />

                                        <!-- Line 2: Album / Subtitle -->
                                        <TextBlock Text="{Binding MusicAlbum, FallbackValue='Best Of'}"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   FontSize="10"
                                                   Margin="0,1,0,0"
                                                   TextTrimming="CharacterEllipsis"
                                                   MaxHeight="14" />

                                        <!-- Line 3: Artist Name -->
                                        <TextBlock Text="{Binding MusicArtist, FallbackValue='Ismaël Lô'}"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   FontSize="10"
                                                   Margin="0,1,0,0"
                                                   TextTrimming="CharacterEllipsis"
                                                   MaxHeight="14" />

                                        <!-- Line 4: Horizontal Transport Controls underneath text -->
                                        <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                            <!-- Prev Button -->
                                            <Button Style="{StaticResource NotchMiniTransportButtonStyle}"
                                                    Command="{Binding MediaSkipPreviousCommand}"
                                                    IsEnabled="{Binding CanSkipPrevious}"
                                                    ToolTip="Previous Track"
                                                    Margin="0,0,6,0">
                                                <Path Data="{StaticResource IconPrevGeometry}"
                                                      Fill="#D4D4D8"
                                                      Width="9"
                                                      Height="9"
                                                      Stretch="Uniform" />
                                            </Button>

                                            <!-- Play/Pause Button -->
                                            <Button Style="{StaticResource NotchMiniTransportButtonStyle}"
                                                    Command="{Binding ToggleMediaPlayPauseCommand}"
                                                    IsEnabled="{Binding CanPlayPause}"
                                                    ToolTip="Play / Pause"
                                                    Margin="0,0,6,0">
                                                <Path Width="10"
                                                      Height="10"
                                                      Stretch="Uniform"
                                                      Fill="#FFFFFF">
                                                    <Path.Style>
                                                        <Style TargetType="Path">
                                                            <Setter Property="Data" Value="{StaticResource IconPlayGeometry}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding MediaIsPlaying}" Value="True">
                                                                    <Setter Property="Data" Value="{StaticResource IconPauseGeometry}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Path.Style>
                                                </Path>
                                            </Button>

                                            <!-- Next Button -->
                                            <Button Style="{StaticResource NotchMiniTransportButtonStyle}"
                                                    Command="{Binding MediaSkipNextCommand}"
                                                    IsEnabled="{Binding CanSkipNext}"
                                                    ToolTip="Next Track">
                                                <Path Data="{StaticResource IconNextGeometry}"
                                                      Fill="#D4D4D8"
                                                      Width="9"
                                                      Height="9"
                                                      Stretch="Uniform" />
                                            </Button>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>

                                <!-- Faint Hairline Divider 1 -->
                                <Rectangle Grid.Column="1"
                                           Width="1"
                                           Height="56"
                                           Fill="#262630"
                                           Margin="0,0"
                                           SnapsToDevicePixels="True"
                                           RenderOptions.EdgeMode="Aliased"
                                           VerticalAlignment="Center" />

                                <!-- SECTION 2: Center Calendar Section (Direct on Black) -->
                                <Grid Grid.Column="2"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      Margin="12,0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <!-- Row 0: Month & Horizontal 7-Day Strip -->
                                    <Grid Grid.Row="0" VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Live Month Label -->
                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding CurrentDateMonthText, FallbackValue='Aug'}"
                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                   FontSize="19"
                                                   FontWeight="Bold"
                                                   FontFamily="Segoe UI Variable Display, Segoe UI, sans-serif"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,12,0" />

                                        <!-- 7-Day Strip with Blue Text Highlight (No box) -->
                                        <ItemsControl Grid.Column="1"
                                                      ItemsSource="{Binding CalendarDays}"
                                                      VerticalAlignment="Center"
                                                      Width="180">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <UniformGrid Columns="7" HorizontalAlignment="Stretch" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel HorizontalAlignment="Center">
                                                        <TextBlock Text="{Binding WeekdayLabel}"
                                                                   FontSize="8"
                                                                   FontFamily="Segoe UI Variable Display, Segoe UI, sans-serif"
                                                                   HorizontalAlignment="Center">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
                                                                    <Setter Property="FontWeight" Value="Normal" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsToday}" Value="True">
                                                                            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                                                                            <Setter Property="FontWeight" Value="SemiBold" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                        <TextBlock Text="{Binding DayNumber}"
                                                                   FontSize="11.5"
                                                                   FontFamily="Segoe UI Variable Display, Segoe UI, sans-serif"
                                                                   HorizontalAlignment="Center"
                                                                   Margin="0,2,0,0">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                                                                    <Setter Property="FontWeight" Value="Normal" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsToday}" Value="True">
                                                                            <Setter Property="Foreground" Value="{StaticResource CalendarBlueBrush}" />
                                                                            <Setter Property="FontWeight" Value="Bold" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Grid>

                                    <!-- Row 1: Calendar Empty-State Icon & Subtitle (Vertically Stacked) -->
                                    <StackPanel Grid.Row="1"
                                                Orientation="Vertical"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Margin="0,5,0,0">
                                        <Path Data="{StaticResource IconCalendarCheckGeometry}"
                                              Fill="{StaticResource TextMutedBrush}"
                                              Width="12"
                                              Height="11"
                                              Stretch="Uniform"
                                              HorizontalAlignment="Center" />
                                        <TextBlock Text="{Binding CalendarEventTitle, FallbackValue='Nothing for today'}"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   FontSize="9.5"
                                                   HorizontalAlignment="Center"
                                                   Margin="0,2,0,0" />
                                    </StackPanel>
                                </Grid>

                                <!-- Faint Hairline Divider 2 -->
                                <Rectangle Grid.Column="3"
                                           Width="1"
                                           Height="56"
                                           Fill="#262630"
                                           Margin="0,0"
                                           SnapsToDevicePixels="True"
                                           RenderOptions.EdgeMode="Aliased"
                                           VerticalAlignment="Center" />

                                <!-- SECTION 3: Right Avatar Section (Direct on Black) -->
                                <Grid Grid.Column="4" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Border Width="64"
                                            Height="64"
                                            CornerRadius="32"
                                            ClipToBounds="True"
                                            Background="#141418">
                                        <Grid>
                                            <!-- Default Avatar Image from Reference Spec -->
                                            <Image Source="pack://application:,,,/GrumphySwarm;component/Resources/avatar_default.png"
                                                   Stretch="UniformToFill"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>
                                </Grid>
                            </Grid>

                            <!-- [1B] AGENTS TAB: Fleet Profile Workspace -->
                            <Grid Visibility="{Binding ActiveTab, Converter={StaticResource EqualityToVisibility}, ConverterParameter='Agents'}">
                                <!-- VIEW: Profiles List -->
                                <Grid Visibility="{Binding IsEditingAgent, Converter={StaticResource InverseBoolToVisibility}}">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <!-- Header -->
                                    <Grid Grid.Row="0" Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="Agent Swarm"
                                                       Foreground="{StaticResource TextPrimaryBrush}"
                                                       FontSize="12"
                                                       FontWeight="SemiBold"
                                                       VerticalAlignment="Center" />
                                            <Border Background="#1C1C24"
                                                    CornerRadius="8"
                                                    Padding="6,1"
                                                    Margin="8,0,0,0"
                                                    VerticalAlignment="Center">
                                                <TextBlock Text="{Binding AgentProfiles.Count, StringFormat='{}{0} configured'}"
                                                           Foreground="{StaticResource TextSecondaryBrush}"
                                                           FontSize="9" />
                                            </Border>
                                        </StackPanel>

                                        <Button Grid.Column="1"
                                                Style="{StaticResource NotchAccentButtonStyle}"
                                                Command="{Binding OpenCreateAgentCommand}">
                                            <StackPanel Orientation="Horizontal">
                                                <Path Data="{StaticResource IconPlusGeometry}"
                                                      Fill="White"
                                                      Width="9"
                                                      Height="9"
                                                      Stretch="Uniform"
                                                      Margin="0,0,4,0"
                                                      VerticalAlignment="Center" />
                                                <TextBlock Text="Create Agent" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                    </Grid>

                                    <!-- Profiles Grid -->
                                    <ScrollViewer Grid.Row="1"
                                                  VerticalScrollBarVisibility="Auto"
                                                  HorizontalScrollBarVisibility="Disabled">
                                        <ItemsControl ItemsSource="{Binding AgentProfiles}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <UniformGrid Columns="2" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type viewModels:AgentItemViewModel}">
                                                    <Border Background="{StaticResource NotchCardBackgroundDarkBrush}"
                                                            BorderBrush="{StaticResource NotchSubtleBorderDarkBrush}"
                                                            BorderThickness="1"
                                                            CornerRadius="10"
                                                            Padding="10,8"
                                                            Margin="3">
                                                        <Grid>
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="Auto" />
                                                                <RowDefinition Height="*" />
                                                                <RowDefinition Height="Auto" />
                                                            </Grid.RowDefinitions>

                                                            <!-- Row 0: Name & Role Badge -->
                                                            <Grid Grid.Row="0">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>

                                                                <TextBlock Grid.Column="0"
                                                                           Text="{Binding Name}"
                                                                           Foreground="{StaticResource TextPrimaryBrush}"
                                                                           FontSize="11"
                                                                           FontWeight="SemiBold"
                                                                           TextTrimming="CharacterEllipsis"
                                                                           VerticalAlignment="Center" />

                                                                <Border Grid.Column="1"
                                                                        Background="#1E1E28"
                                                                        CornerRadius="5"
                                                                        Padding="5,1"
                                                                        Margin="4,0,0,0">
                                                                    <TextBlock Text="{Binding TaskTypeLabel}"
                                                                               Foreground="{StaticResource TextSecondaryBrush}"
                                                                               FontSize="8" />
                                                                </Border>
                                                            </Grid>

                                                            <!-- Row 1: Description -->
                                                            <TextBlock Grid.Row="1"
                                                                       Text="{Binding Description}"
                                                                       Foreground="{StaticResource TextMutedBrush}"
                                                                       FontSize="9"
                                                                       TextWrapping="Wrap"
                                                                       MaxHeight="26"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       Margin="0,3,0,5" />

                                                            <!-- Row 2: Standby Status Note & Actions -->
                                                            <Grid Grid.Row="2">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>

                                                                <Border Grid.Column="0"
                                                                        Background="#181822"
                                                                        BorderBrush="{StaticResource NotchSubtleBorderDarkBrush}"
                                                                        BorderThickness="1"
                                                                        CornerRadius="4"
                                                                        Padding="4,1"
                                                                        HorizontalAlignment="Left"
                                                                        VerticalAlignment="Center">
                                                                    <TextBlock Text="{Binding StatusNote}"
                                                                               Foreground="#94A3B8"
                                                                               FontSize="8" />
                                                                </Border>

                                                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                                    <Button Style="{StaticResource NotchIconButtonStyle}"
                                                                            Command="{Binding EditCommand}"
                                                                            ToolTip="Edit Profile"
                                                                            Padding="2"
                                                                            Margin="0,0,2,0">
                                                                        <Path Data="{StaticResource IconEditGeometry}"
                                                                              Fill="{StaticResource TextMutedBrush}"
                                                                              Width="9"
                                                                              Height="9"
                                                                              Stretch="Uniform" />
                                                                    </Button>
                                                                    <Button Style="{StaticResource NotchIconButtonStyle}"
                                                                            Command="{Binding DeleteCommand}"
                                                                            ToolTip="Delete Profile"
                                                                            Padding="2">
                                                                        <Path Data="{StaticResource IconDeleteGeometry}"
                                                                              Fill="{StaticResource TextMutedBrush}"
                                                                              Width="9"
                                                                              Height="9"
                                                                              Stretch="Uniform" />
                                                                    </Button>
                                                                </StackPanel>
                                                            </Grid>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Grid>

                                <!-- VIEW: Agent Editor Modal Card -->
                                <Border Visibility="{Binding IsEditingAgent, Converter={StaticResource BoolToVisibility}}"
                                        Background="{StaticResource NotchCardBackgroundDarkBrush}"
                                        BorderBrush="{StaticResource NotchBorderDarkBrush}"
                                        BorderThickness="1"
                                        CornerRadius="12"
                                        Padding="14,10">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.Row="0"
                                                   Text="{Binding EditorTitle}"
                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   Margin="0,0,0,8" />

                                        <Grid Grid.Row="1" Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="65" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Name:" Foreground="{StaticResource TextSecondaryBrush}" FontSize="10" VerticalAlignment="Center" />
                                            <TextBox Grid.Column="1" Style="{StaticResource NotchTextBoxStyle}" Text="{Binding EditorAgentName, UpdateSourceTrigger=PropertyChanged}" />
                                        </Grid>

                                        <Grid Grid.Row="2" Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="65" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Task Goal:" Foreground="{StaticResource TextSecondaryBrush}" FontSize="10" VerticalAlignment="Center" />
                                            <TextBox Grid.Column="1" Style="{StaticResource NotchTextBoxStyle}" Text="{Binding EditorAgentDescription, UpdateSourceTrigger=PropertyChanged}" />
                                        </Grid>

                                        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
                                            <Button Style="{StaticResource NotchGhostButtonStyle}" Command="{Binding CancelAgentEditCommand}" Margin="0,0,6,0">
                                                <TextBlock Text="Cancel" />
                                            </Button>
                                            <Button Style="{StaticResource NotchAccentButtonStyle}" Command="{Binding SaveAgentProfileCommand}">
                                                <TextBlock Text="Save Agent" />
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Grid>

                        <!-- ============================================================== -->
                        <!-- [VIEW 2] NOW PLAYING CONTROL CENTER (Reference 4)               -->
                        <!-- ============================================================== -->
                        <Border Visibility="{Binding ActiveView, Converter={StaticResource EqualityToVisibility}, ConverterParameter='NowPlayingCenter'}"
                                Background="{StaticResource NotchCardBackgroundDarkBrush}"
                                BorderBrush="{StaticResource NotchSubtleBorderDarkBrush}"
                                BorderThickness="1"
                                CornerRadius="14"
                                Padding="14,10">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <!-- Artwork & Title & Equalizer -->
                                    <RowDefinition Height="Auto" />
                                    <!-- Progress Bar & Timestamps -->
                                    <RowDefinition Height="Auto" />
                                    <!-- Playback & Volume Controls Row -->
                                </Grid.RowDefinitions>

                                <!-- Top Row: Large Artwork + Metadata + Equalizer Wave -->
                                <Grid Grid.Row="0" Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Artwork with rounded corners -->
                                    <Border Grid.Column="0"
                                            Width="64"
                                            Height="64"
                                            CornerRadius="10"
                                            ClipToBounds="True"
                                            Background="#181822"
                                            Margin="0,0,12,0">
                                        <Grid>
                                            <Image Source="{Binding MediaThumbnailSource}"
                                                   Stretch="UniformToFill"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                            <Border Background="#1C1C26"
                                                    Visibility="{Binding MediaThumbnailSource, Converter={StaticResource InverseNullToVisibility}, FallbackValue=Visible}">
                                                <Path Data="{StaticResource IconMusicNoteGeometry}"
                                                      Fill="{StaticResource TextMutedBrush}"
                                                      Width="22"
                                                      Height="22"
                                                      Stretch="Uniform"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center" />
                                            </Border>
                                        </Grid>
                                    </Border>

                                    <!-- Track Title & Artist -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding MusicTrackTitle}"
                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                   FontSize="14"
                                                   FontWeight="SemiBold"
                                                   FontFamily="Segoe UI Variable Display, Segoe UI, sans-serif"
                                                   TextTrimming="CharacterEllipsis" />

                                        <TextBlock Text="{Binding MusicArtist}"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   FontSize="11"
                                                   Margin="0,2,0,0"
                                                   TextTrimming="CharacterEllipsis" />

                                        <TextBlock Text="{Binding MediaSourceAppName}"
                                                   Foreground="{StaticResource TextMutedBrush}"
                                                   FontSize="9"
                                                   Margin="0,2,0,0" />
                                    </StackPanel>

                                    <!-- Equalizer Visualizer Wave Bars (Right) -->
                                    <StackPanel Grid.Column="2"
                                                Orientation="Horizontal"
                                                VerticalAlignment="Center"
                                                HorizontalAlignment="Right"
                                                Margin="0,0,4,0">
                                        <!-- Bar 1 -->
                                        <Border Width="3" Height="{Binding EqualizerBar1Height}"
                                                Background="{StaticResource CalendarBlueBrush}"
                                                CornerRadius="1.5"
                                                Margin="1.5,0"
                                                VerticalAlignment="Bottom" />
                                        <!-- Bar 2 -->
                                        <Border Width="3" Height="{Binding EqualizerBar2Height}"
                                                Background="{StaticResource CalendarBlueBrush}"
                                                CornerRadius="1.5"
                                                Margin="1.5,0"
                                                VerticalAlignment="Bottom" />
                                        <!-- Bar 3 -->
                                        <Border Width="3" Height="{Binding EqualizerBar3Height}"
                                                Background="{StaticResource CalendarBlueBrush}"
                                                CornerRadius="1.5"
                                                Margin="1.5,0"
                                                VerticalAlignment="Bottom" />
                                        <!-- Bar 4 -->
                                        <Border Width="3" Height="{Binding EqualizerBar4Height}"
                                                Background="{StaticResource CalendarBlueBrush}"
                                                CornerRadius="1.5"
                                                Margin="1.5,0"
                                                VerticalAlignment="Bottom" />
                                    </StackPanel>
                                </Grid>

                                <!-- Middle Row: Progress Bar & Timestamps -->
                                <Grid Grid.Row="1" Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Elapsed Time Text -->
                                    <TextBlock Grid.Column="0"
                                               Text="{Binding MediaPositionText}"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               FontSize="10"
                                               FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif"
                                               Typography.NumeralAlignment="Tabular"
                                               VerticalAlignment="Center"
                                               Margin="0,0,8,0" />

                                    <!-- Progress Slider Track -->
                                    <Border Grid.Column="1"
                                            Height="4"
                                            Background="#2A2A36"
                                            CornerRadius="2"
                                            VerticalAlignment="Center">
                                        <Border HorizontalAlignment="Left"
                                                Height="4"
                                                CornerRadius="2"
                                                Background="{StaticResource CalendarBlueBrush}">
                                            <Border.Width>
                                                <MultiBinding Converter="{StaticResource ProgressToWidth}">
                                                    <Binding Path="MediaProgress" />
                                                    <Binding RelativeSource="{RelativeSource AncestorType=Border, AncestorLevel=1}" Path="ActualWidth" />
                                                </MultiBinding>
                                            </Border.Width>
                                        </Border>
                                    </Border>

                                    <!-- Remaining Time Text -->
                                    <TextBlock Grid.Column="2"
                                               Text="{Binding MediaRemainingText}"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               FontSize="10"
                                               FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif"
                                               Typography.NumeralAlignment="Tabular"
                                               VerticalAlignment="Center"
                                               Margin="8,0,0,0" />
                                </Grid>

                                <!-- Bottom Row: Transport Controls + Volume Visualizer -->
                                <Grid Grid.Row="2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Favorite / Star Icon -->
                                    <Button Grid.Column="0"
                                            Style="{StaticResource NotchIconButtonStyle}"
                                            ToolTip="Favorite track">
                                        <Path Data="{StaticResource IconStarGeometry}"
                                              Fill="{StaticResource TextSecondaryBrush}"
                                              Width="14"
                                              Height="14"
                                              Stretch="Uniform" />
                                    </Button>

                                    <!-- Centered Playback Controls -->
                                    <StackPanel Grid.Column="1"
                                                Orientation="Horizontal"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center">
                                        <!-- Previous Track -->
                                        <Button Style="{StaticResource NotchIconButtonStyle}"
                                                Command="{Binding MediaSkipPreviousCommand}"
                                                IsEnabled="{Binding CanSkipPrevious}"
                                                Padding="6"
                                                Margin="0,0,8,0"
                                                ToolTip="Previous">
                                            <Path Data="{StaticResource IconPrevGeometry}"
                                                  Fill="{StaticResource TextPrimaryBrush}"
                                                  Width="14"
                                                  Height="14"
                                                  Stretch="Uniform" />
                                        </Button>

                                        <!-- Play / Pause Prominent Button -->
                                        <Button Style="{StaticResource NotchIconButtonStyle}"
                                                Command="{Binding ToggleMediaPlayPauseCommand}"
                                                IsEnabled="{Binding CanPlayPause}"
                                                Padding="8"
                                                Margin="0,0,8,0"
                                                ToolTip="Play / Pause">
                                            <Path Width="18"
                                                  Height="18"
                                                  Stretch="Uniform"
                                                  Fill="{StaticResource TextPrimaryBrush}">
                                                <Path.Style>
                                                    <Style TargetType="Path">
                                                        <Setter Property="Data" Value="{StaticResource IconPlayGeometry}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding MediaIsPlaying}" Value="True">
                                                                <Setter Property="Data" Value="{StaticResource IconPauseGeometry}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Path.Style>
                                            </Path>
                                        </Button>

                                        <!-- Next Track -->
                                        <Button Style="{StaticResource NotchIconButtonStyle}"
                                                Command="{Binding MediaSkipNextCommand}"
                                                IsEnabled="{Binding CanSkipNext}"
                                                Padding="6"
                                                ToolTip="Next">
                                            <Path Data="{StaticResource IconNextGeometry}"
                                                  Fill="{StaticResource TextPrimaryBrush}"
                                                  Width="14"
                                                  Height="14"
                                                  Stretch="Uniform" />
                                        </Button>
                                    </StackPanel>

                                    <!-- Right: Volume Level Readout & Compact Visualizer Bars -->
                                    <StackPanel Grid.Column="2"
                                                Orientation="Horizontal"
                                                VerticalAlignment="Center"
                                                ToolTip="Current System Volume">
                                        <Path Data="{StaticResource IconVolumeGeometry}"
                                              Fill="{StaticResource TextSecondaryBrush}"
                                              Width="11"
                                              Height="11"
                                              Stretch="Uniform"
                                              Margin="0,0,4,0"
                                              VerticalAlignment="Center" />

                                        <TextBlock Text="{Binding VolumeText}"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   FontSize="10"
                                                   FontWeight="SemiBold"
                                                   Typography.NumeralAlignment="Tabular"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,6,0" />

                                        <!-- 4-step Volume Level Visualizer Bars -->
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border Width="2.5" Height="4" CornerRadius="1" Margin="1,0"
                                                    Background="{StaticResource TextPrimaryBrush}" />
                                            <Border Width="2.5" Height="7" CornerRadius="1" Margin="1,0">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="#333342" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding VolumeLevelStep, Converter={StaticResource EqualityToVisibility}, ConverterParameter=2}" Value="Visible">
                                                                <Setter Property="Background" Value="{StaticResource TextPrimaryBrush}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding VolumeLevelStep, Converter={StaticResource EqualityToVisibility}, ConverterParameter=3}" Value="Visible">
                                                                <Setter Property="Background" Value="{StaticResource TextPrimaryBrush}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding VolumeLevelStep, Converter={StaticResource EqualityToVisibility}, ConverterParameter=4}" Value="Visible">
                                                                <Setter Property="Background" Value="{StaticResource TextPrimaryBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                            </Border>
                                            <Border Width="2.5" Height="10" CornerRadius="1" Margin="1,0">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="#333342" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding VolumeLevelStep, Converter={StaticResource EqualityToVisibility}, ConverterParameter=3}" Value="Visible">
                                                                <Setter Property="Background" Value="{StaticResource TextPrimaryBrush}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding VolumeLevelStep, Converter={StaticResource EqualityToVisibility}, ConverterParameter=4}" Value="Visible">
                                                                <Setter Property="Background" Value="{StaticResource TextPrimaryBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                            </Border>
                                            <Border Width="2.5" Height="13" CornerRadius="1" Margin="1,0">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="#333342" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding VolumeLevelStep, Converter={StaticResource EqualityToVisibility}, ConverterParameter=4}" Value="Visible">
                                                                <Setter Property="Background" Value="{StaticResource TextPrimaryBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                            </Border>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Border>

                        <!-- ============================================================== -->
                        <!-- [VIEW 3] SETTINGS & LIVE PREVIEW CUSTOMIZATION                 -->
                        <!-- ============================================================== -->
                        <Border Visibility="{Binding ActiveView, Converter={StaticResource EqualityToVisibility}, ConverterParameter='Settings'}"
                                Background="{StaticResource NotchCardBackgroundDarkBrush}"
                                BorderBrush="{StaticResource NotchSubtleBorderDarkBrush}"
                                BorderThickness="1"
                                CornerRadius="14"
                                Padding="14,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <!-- Left Column: Controls (Width, Height, Position) -->
                                    <ColumnDefinition Width="1.4*" />
                                    <ColumnDefinition Width="14" />
                                    <!-- Right Column: Live Monitor Display Simulation Preview -->
                                    <ColumnDefinition Width="1.2*" />
                                </Grid.ColumnDefinitions>

                                <!-- Left Column: Sliders and Segmented Toggles -->
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <!-- Collapsed Width Slider -->
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Width:" Foreground="{StaticResource TextSecondaryBrush}" FontSize="10" VerticalAlignment="Center" Margin="0,0,8,0" />
                                        <Slider Grid.Column="1"
                                                Style="{StaticResource NotchSliderStyle}"
                                                Minimum="180"
                                                Maximum="450"
                                                SmallChange="5"
                                                LargeChange="20"
                                                Value="{Binding PendingCollapsedWidth, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding PendingCollapsedWidth, Converter={StaticResource DoubleToPx}}"
                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                   FontSize="10"
                                                   FontWeight="SemiBold"
                                                   VerticalAlignment="Center"
                                                   Margin="8,0,0,0"
                                                   Width="46"
                                                   TextAlignment="Right" />
                                    </Grid>

                                    <!-- Collapsed Height Slider -->
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Height:" Foreground="{StaticResource TextSecondaryBrush}" FontSize="10" VerticalAlignment="Center" Margin="0,0,8,0" />
                                        <Slider Grid.Column="1"
                                                Style="{StaticResource NotchSliderStyle}"
                                                Minimum="28"
                                                Maximum="52"
                                                SmallChange="2"
                                                LargeChange="4"
                                                Value="{Binding PendingCollapsedHeight, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding PendingCollapsedHeight, Converter={StaticResource DoubleToPx}}"
                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                   FontSize="10"
                                                   FontWeight="SemiBold"
                                                   VerticalAlignment="Center"
                                                   Margin="8,0,0,0"
                                                   Width="46"
                                                   TextAlignment="Right" />
                                    </Grid>

                                    <!-- Horizontal Position Segmented Buttons -->
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                        <TextBlock Text="Position:" Foreground="{StaticResource TextSecondaryBrush}" FontSize="10" VerticalAlignment="Center" Margin="0,0,6,0" />
                                        <Button Style="{StaticResource NotchSegmentedButtonStyle}"
                                                Content="Left"
                                                Command="{Binding SetPendingPositionCommand}"
                                                CommandParameter="Left"
                                                Tag="{Binding PendingHorizontalPosition, Converter={StaticResource PositionToTag}, ConverterParameter='Left'}"
                                                Margin="0,0,4,0" />
                                        <Button Style="{StaticResource NotchSegmentedButtonStyle}"
                                                Content="Center"
                                                Command="{Binding SetPendingPositionCommand}"
                                                CommandParameter="Center"
                                                Tag="{Binding PendingHorizontalPosition, Converter={StaticResource PositionToTag}, ConverterParameter='Center'}"
                                                Margin="0,0,4,0" />
                                        <Button Style="{StaticResource NotchSegmentedButtonStyle}"
                                                Content="Right"
                                                Command="{Binding SetPendingPositionCommand}"
                                                CommandParameter="Right"
                                                Tag="{Binding PendingHorizontalPosition, Converter={StaticResource PositionToTag}, ConverterParameter='Right'}"
                                                Margin="0,0,4,0" />
                                        <Button Style="{StaticResource NotchSegmentedButtonStyle}"
                                                Content="Custom"
                                                Command="{Binding SetPendingPositionCommand}"
                                                CommandParameter="Custom"
                                                Tag="{Binding PendingHorizontalPosition, Converter={StaticResource PositionToTag}, ConverterParameter='Custom'}" />
                                    </StackPanel>

                                    <!-- Custom Horizontal Offset Slider (Visible when Position is Custom) -->
                                    <Grid Margin="0,0,0,8"
                                          Visibility="{Binding PendingHorizontalPosition, Converter={StaticResource EqualityToVisibility}, ConverterParameter='Custom'}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Offset:" Foreground="{StaticResource TextSecondaryBrush}" FontSize="10" VerticalAlignment="Center" Margin="0,0,8,0" />
                                        <Slider Grid.Column="1"
                                                Style="{StaticResource NotchSliderStyle}"
                                                Minimum="-400"
                                                Maximum="400"
                                                Value="{Binding PendingHorizontalOffset, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding PendingHorizontalOffset, Converter={StaticResource DoubleToPx}}"
                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                   FontSize="10"
                                                   FontWeight="SemiBold"
                                                   VerticalAlignment="Center"
                                                   Margin="8,0,0,0"
                                                   Width="46"
                                                   TextAlignment="Right" />
                                    </Grid>

                                    <!-- Action Buttons: Apply, Cancel, Reset -->
                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                        <!-- Apply Button (Commits settings to live notch & saves to JSON) -->
                                        <Button Style="{StaticResource NotchAccentButtonStyle}"
                                                Command="{Binding ApplySettingsCommand}"
                                                ToolTip="Apply changes to live notch"
                                                Margin="0,0,6,0">
                                            <StackPanel Orientation="Horizontal">
                                                <Path Data="{StaticResource IconCheckGeometry}" Fill="White" Width="9" Height="9" Stretch="Uniform" Margin="0,0,4,0" VerticalAlignment="Center" />
                                                <TextBlock Text="Apply" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>

                                        <!-- Cancel Button -->
                                        <Button Style="{StaticResource NotchGhostButtonStyle}"
                                                Command="{Binding CancelSettingsCommand}"
                                                ToolTip="Discard unapplied changes"
                                                Margin="0,0,6,0">
                                            <TextBlock Text="Cancel" />
                                        </Button>

                                        <!-- Reset Defaults -->
                                        <Button Style="{StaticResource NotchGhostButtonStyle}"
                                                Command="{Binding ResetSettingsDefaultsCommand}"
                                                ToolTip="Reset to defaults">
                                            <StackPanel Orientation="Horizontal">
                                                <Path Data="{StaticResource IconResetGeometry}" Fill="{StaticResource TextMutedBrush}" Width="9" Height="9" Stretch="Uniform" Margin="0,0,4,0" VerticalAlignment="Center" />
                                                <TextBlock Text="Reset" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </StackPanel>

                                <!-- Right Column: Live Monitor Display Simulation Preview Frame -->
                                <Border Grid.Column="2"
                                        Background="#09090D"
                                        BorderBrush="{StaticResource NotchBorderDarkBrush}"
                                        BorderThickness="1.5"
                                        CornerRadius="10"
                                        Height="96"
                                        VerticalAlignment="Center"
                                        ClipToBounds="True">
                                    <Grid>
                                        <!-- Monitor Header Bezel Bar -->
                                        <Border Height="3" Background="#1C1C26" VerticalAlignment="Top" />

                                        <!-- Live Preview Notch (Preserves exact silhouette, flare & position) -->
                                        <Canvas HorizontalAlignment="Stretch" VerticalAlignment="Top" Height="40">
                                            <Grid Canvas.Left="{Binding PreviewMarginLeft}"
                                                  Canvas.Top="0"
                                                  Width="{Binding PreviewWidth}"
                                                  Height="{Binding PreviewHeight}">
                                                <!-- Pure Black Flared Notch Shape -->
                                                <Path Data="{Binding PreviewGeometry}"
                                                      Fill="#000000"
                                                      HorizontalAlignment="Stretch"
                                                      VerticalAlignment="Stretch" />

                                                <!-- Mini preview volume indicator -->
                                                <Grid Margin="8,0">
                                                    <Path Data="{StaticResource IconVolumeGeometry}"
                                                          Fill="White"
                                                          Width="6"
                                                          Height="6"
                                                          Stretch="Uniform"
                                                          HorizontalAlignment="Left"
                                                          VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding VolumeText}"
                                                               Foreground="White"
                                                               FontSize="6"
                                                               FontWeight="SemiBold"
                                                               HorizontalAlignment="Right"
                                                               VerticalAlignment="Center" />
                                                </Grid>
                                            </Grid>
                                        </Canvas>

                                        <!-- Preview Label -->
                                        <TextBlock Text="Live Display Preview"
                                                   Foreground="{StaticResource TextMutedBrush}"
                                                   FontSize="8"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Bottom"
                                                   Margin="0,0,0,6" />
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>

                    </Grid>
                </Grid>

            </Grid>
        </Grid>
    </Grid>
</Window>
